# Frontend environment contract.
#
# Copy this file to `.env.local` and replace the placeholders for local use.
# Real `.env*` files are ignored by Git; only this example is committed.
#
# IMPORTANT: every variable prefixed with `VITE_` is embedded in the browser
# bundle and is PUBLIC. Only browser-safe values belong here.
# Privileged values (secret keys, service credentials, webhook secrets,
# external provider secrets) must NEVER use the `VITE_` prefix.

# Supabase project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (safe for the browser; access is enforced by RLS).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
